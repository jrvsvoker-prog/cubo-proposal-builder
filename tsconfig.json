{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@cuboapp/ui-vue": ["vendor/cubo/ui/index.d.ts"],
      "@cuboapp/ui-vue/icons": ["vendor/cubo/ui/icons.d.ts"]
    }
  },
  "files": ["src/main.ts", "src/stand/main.ts", "src/proposal-env.d.ts", "src/data/profiles.typecheck.ts"]
}
